# LexiLens Environment Configuration

# Application
PORT=3000
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=LexiLens
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SQL Database
# Defaults to embedded SQL storage (lexilens.sqlite) with full ACID relations & vector cosine indexing.
# For remote PostgreSQL, specify: postgresql://user:password@localhost:5432/lexilens
DATABASE_URL=file:./lexilens.sqlite

# AI Provider Configuration
# Optional: Enter Gemini API key to enable live Google Gemini 1.5/2.0 multimodal analysis.
# If omitted, LexiLens runs using its deterministic, high-precision grounded legal reasoning engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Security & Session Secrets
JWT_SECRET=super-secret-lexilens-jwt-token-change-in-production
STORAGE_DIR=./storage/documents

# Rate Limiting & File Upload Limits
MAX_FILE_SIZE_MB=15
ENABLE_OCR_FALLBACK=true
